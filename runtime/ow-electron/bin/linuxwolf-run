#!/usr/bin/env bash
# Run an installed ow-electron app (e.g. MetaBot) on Linux.
#
#   linuxwolf-run <app folder | app.asar> [app args...]
#
# Environment:
#   LINUXWOLF_BACKEND=x11|wayland   window system (default: x11, i.e. XWayland
#                                   on a Wayland session; see src/windows.js)
#   LINUXWOLF_ELECTRON=<path>       Electron binary (default: the one from npm)
#   LINUXWOLF_OW_PACKAGES=gep,...   Overwolf packages to announce (default: none)
#   LINUXWOLF_STEAM_ROOT=<path>     Steam install, if not in a standard place
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ $# -lt 1 ]]; then
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
app="$1"; shift

# Electron comes from npm. Since Electron 42 the npm package no longer
# downloads its binary during `npm install`; it is fetched on first use.
# Do both steps here, with visible output, so a failure is not silent.
electron="${LINUXWOLF_ELECTRON:-}"
if [[ -z "$electron" ]]; then
  pkg="$here/node_modules/electron"
  command -v node >/dev/null || { echo "linuxwolf-run: node not found (need Node.js >= 22.12)" >&2; exit 2; }
  if [[ ! -f "$pkg/package.json" ]]; then
    echo "linuxwolf-run: installing npm dependencies in $here" >&2
    (cd "$here" && npm install --no-audit --no-fund) >&2 || { echo "linuxwolf-run: npm install failed" >&2; exit 2; }
  fi
  if [[ ! -f "$pkg/path.txt" || ! -x "$pkg/dist/$(cat "$pkg/path.txt" 2>/dev/null)" ]]; then
    echo "linuxwolf-run: downloading the Electron binary (one time)" >&2
    node "$pkg/install.js" >&2 || {
      echo "linuxwolf-run: Electron download failed. Check your network/proxy, then run: node $pkg/install.js" >&2
      exit 2
    }
  fi
  electron="$pkg/dist/$(cat "$pkg/path.txt")"
fi
if [[ ! -x "$electron" ]]; then
  echo "linuxwolf-run: Electron binary not found at $electron (set LINUXWOLF_ELECTRON to an Electron 42 binary)" >&2
  exit 2
fi

backend="${LINUXWOLF_BACKEND:-x11}"
flags=()
case "$backend" in
  x11)
    flags+=(--ozone-platform=x11)
    ;;
  wayland)
    flags+=(--ozone-platform=wayland --enable-features=GlobalShortcutsPortal,WaylandWindowDecorations)
    ;;
  *)
    echo "linuxwolf-run: unknown LINUXWOLF_BACKEND=$backend (x11 or wayland)" >&2
    exit 2
    ;;
esac
export LINUXWOLF_BACKEND="$backend"

# Electron refuses to start as root without --no-sandbox (containers, CI).
[[ "$(id -u)" == 0 ]] && flags+=(--no-sandbox)

exec "$electron" "${flags[@]}" "$here/src/main.js" "--lw-app=$app" "$@"
