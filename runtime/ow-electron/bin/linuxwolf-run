#!/usr/bin/env bash
# Run an installed ow-electron app (e.g. MetaBot) on Linux.
#
#   linuxwolf-run <app folder | app.asar> [app args...]
#
# Environment:
#   LINUXWOLF_BACKEND=x11|wayland   window system (default: x11, i.e. XWayland
#                                   on a Wayland session; see src/windows.js)
#   LINUXWOLF_ELECTRON=<path>       Electron binary (default: the one from npm)
#   LINUXWOLF_OW_PACKAGES=gep,...   Overwolf packages to announce (default: none)
#   LINUXWOLF_STEAM_ROOT=<path>     Steam install, if not in a standard place
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ $# -lt 1 ]]; then
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
app="$1"; shift

electron="$("$here/bin/lw-electron")" || exit 2

backend="${LINUXWOLF_BACKEND:-x11}"
flags=()
case "$backend" in
  x11)
    flags+=(--ozone-platform=x11)
    ;;
  wayland)
    flags+=(--ozone-platform=wayland --enable-features=GlobalShortcutsPortal,WaylandWindowDecorations)
    ;;
  *)
    echo "linuxwolf-run: unknown LINUXWOLF_BACKEND=$backend (x11 or wayland)" >&2
    exit 2
    ;;
esac
export LINUXWOLF_BACKEND="$backend"

# Electron refuses to start as root without --no-sandbox (containers, CI).
[[ "$(id -u)" == 0 ]] && flags+=(--no-sandbox)

exec "$electron" "${flags[@]}" "$here/src/main.js" "--lw-app=$app" "$@"
